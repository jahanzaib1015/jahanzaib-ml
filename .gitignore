# ============================================================
#  JAHANZAIB — PORTFOLIO  .gitignore
#  Keeps secrets, vendored sub-projects, and local dev artifacts
#  out of the public repository.
# ============================================================

# ---- Unrelated / vendored sub-projects (separate repos; may carry their own
#      .env, node_modules, and git history — never publish from here) ----
/freellmapi/

# ---- Local working files, backups, and scratch/experiment output ----
/.scratch/
/.draft/
*.log
/tmp/
.scratch/
.draft/

# ---- Environment variables, keys, certificates, and credentials ----
.env
.env.*
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.keystore
*.jks
credentials.json
secrets.json
secret.*
*_rsa
*_rsa.pub
*_ed25519
*_ed25519.pub
service-account*.json

# ---- Node / package managers (if any tooling is added later) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json.bak

# ---- OS / editor / IDE junk ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/
*.swp
*.swo
*~
